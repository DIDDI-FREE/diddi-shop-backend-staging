DIDDI_SHOP_ENVIRONMENT=staging
DIDDI_SHOP_DATABASE_URL=postgresql+asyncpg://diddishop:change-me@localhost:5432/diddishop
DIDDI_SHOP_REDIS_URL=redis://localhost:6379/0
DIDDI_SHOP_DIDDIFREEID_BASE_URL=https://auth-staging.diddifree.com
DIDDI_SHOP_DIDDIFREEID_JWKS_URL=https://auth-staging.diddifree.com/.well-known/jwks.json
DIDDI_SHOP_DIDDIPAY_BASE_URL=https://pay-api-staging.diddifree.com/payfund/v1
DIDDI_SHOP_DIDDISEND_BASE_URL=https://diddisend-api-staging.diddifree.com
DIDDI_SHOP_DIDDIFILES_BASE_URL=https://diddifiles.diddifree.com
DIDDI_SHOP_DIDDIFILES_S3_ENDPOINT=https://s3.diddifiles.diddifree.com
DIDDI_SHOP_DIDDIREWARDS_BASE_URL=https://diddi-rewards-staging.diddifree.com
DIDDI_SHOP_DIDDICOMMS_BASE_URL=https://diddi-comm-staging.diddifree.com
DIDDI_SHOP_DIDDISUPPORT_BASE_URL=https://support-backend-staging.diddifree.com
DIDDI_SHOP_DIDDIOBSERVE_BASE_URL=https://logs-otel.diddifree.com
DIDDI_SHOP_DIDDIFREEID_ISSUER=
DIDDI_SHOP_DIDDIFREEID_SERVICE_TOKEN_URL=https://auth-staging.diddifree.com/identity/v1/auth/service/token
# One DiddiFreeID client per target service. Values are provisioned by DiddiFreeID.
DIDDI_SHOP_SERVICE_CLIENT_IDS={"diddipay":"diddishop-staging-diddipay","diddisend":"diddishop-staging-diddisend","diddifiles":"diddishop-staging-diddifiles","diddirewards":"diddishop-staging-diddirewards","diddicomms":"diddishop-staging-diddicomms","diddisupport":"diddishop-staging-diddisupport"}
# Inject this JSON map through the deployment secret manager; never commit it.
# DIDDI_SHOP_SERVICE_CLIENT_SECRETS={"diddipay":"...","diddisend":"...","diddifiles":"...","diddirewards":"...","diddicomms":"...","diddisupport":"..."}
DIDDI_SHOP_DIDDIPAY_WEBHOOK_SECRET=
DIDDI_SHOP_DIDDISEND_WEBHOOK_SECRET=
# V1 : aucun hold marketplace ni release vendeur. Activer uniquement en V2
# après validation du contrat DiddiPay.
DIDDI_SHOP_SELLER_RELEASE_ENABLED=false
# Inject service_tokens/service_keys through the deployment secret manager.

# DiddiObserve onboarding: OTLP HTTP/protobuf only. The header value is a
# dedicated Basic credential injected from secrets/onboarding/diddishop.env;
# never commit the real value and never reuse a business S2S secret.
OTEL_SERVICE_NAME=diddishop
ENVIRONMENT=staging
DEPLOYMENT_ID=diddishop-staging
DIDDI_COMPONENT=api
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_LOGS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://logs-otel.diddifree.com/otlp/diddishop
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://logs-otel.diddifree.com/otlp/diddishop/v1/logs
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://logs-otel.diddifree.com/otlp/diddishop/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <dedicated-credential>
# METRICS_BEARER_TOKEN=<dedicated-scrape-token>
